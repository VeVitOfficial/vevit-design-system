  },
  "files": ["dist", "fonts"],
  "sideEffects": ["*.css"],
  "scripts": { "build": "node build.mjs" },
  "peerDependencies": { "react": ">=18", "react-dom": ">=18" },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "esbuild": "^0.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
