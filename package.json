{
  "name": "@vevit/design-system",
  "version": "1.0.0",
  "description": "VeVit design system: tokens, fonts and React components extracted from vevit.cz (home, ecosystem, tools, premium) in dark and light themes.",
  "type": "module",
  "main": "dist/index.es.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.es.js" },
